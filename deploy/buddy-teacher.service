[Unit]
Description=Buddy Teacher (FastAPI)
After=network-online.target ollama.service
Wants=network-online.target ollama.service

[Service]
Type=simple
User=buddy
Group=buddy
WorkingDirectory=/opt/buddy-teacher
Environment=HF_HOME=/opt/buddy-teacher/.cache/huggingface
Environment=TOKENIZERS_PARALLELISM=false
# Bound to localhost only; Tailscale Serve is the only way in (no public ports).
ExecStart=/opt/buddy-teacher/.venv/bin/uvicorn buddy.app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/buddy-teacher/data /opt/buddy-teacher/.cache

[Install]
WantedBy=multi-user.target
