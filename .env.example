# Copy to .env and fill in. This file is read by the server only; nothing
# here is ever sent to the browser.

# Claude API key (server-side only)
ANTHROPIC_API_KEY=
# Only if the API says the key "is not scoped to a workspace": the workspace ID
# (wrkspc_...) from Claude Console -> Settings -> Workspaces.
ANTHROPIC_WORKSPACE_ID=

# Login passwords (kid uses the chat page; parent can also see the log and upload)
KID_PASSWORD=change-me-kid
PARENT_PASSWORD=change-me-parent
# Long random string, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
SESSION_SECRET=

# Local model served by Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Embeddings: "bge-m3" (real, local) or "hash" (tiny fake, for tests only)
EMBEDDER=bge-m3

# Where PDFs, processed chapters, the vector DB and logs live
DATA_DIR=./data

# Retrieval score (cosine similarity, 0-1) below which a question goes to Claude
LOW_SCORE_THRESHOLD=0.45

HOST=127.0.0.1
PORT=8000

# Fixed answers: similarity at which a fix is used (0.80) / answered directly (0.92)
VERIFIED_THRESHOLD=0.80
VERIFIED_DIRECT=0.92

# Nightly review: Claude (Sonnet 5, Batch API) re-checks weak and 👎 answers and
# auto-applies fixes (undo in the parent view). Runs inside the server.
REVIEW_ENABLED=true
REVIEW_TIME=02:30
REVIEW_TZ=Asia/Kolkata
REVIEW_BUDGET_USD=0.50
REVIEW_MAX_ITEMS=40
